---
// UI Elements
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Components
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Education from '../components/Education.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
// Supports weights 100-900
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';

interface LayoutProps {
  title: string;
  lang: 'es' | 'en';
  cv: any;
}

const { title } = Astro.props;
const { lang, cv } = Astro.props as LayoutProps;
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title}</title>

    <!-- Theme toggle (no flash) -->
    <script is:inline>
      (() => {
        const getPreferredTheme = () => {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') return saved;
          return window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        };

        const applyTheme = (theme) => {
          const isDark = theme === 'dark';
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.style.colorScheme = isDark
            ? 'dark'
            : 'light';
          localStorage.setItem('theme', theme);
        };

        // apply on load (avoid flash)
        applyTheme(getPreferredTheme());

        // global listener (works for desktop+mobile theme buttons)
        document.addEventListener('click', (e) => {
          const btn = e.target?.closest?.('[data-theme-toggle]');
          if (!btn) return;

          const isDark = document.documentElement.classList.contains('dark');
          applyTheme(isDark ? 'light' : 'dark');
        });
      })();
    </script>
  </head>

  <body class="bg-(--bg) text-(--text)">
    <Header
      {lang}
      {cv}
    />

    <main>
      <Hero data={cv.hero} />
      <About data={{ about: cv.about, skills: cv.skills, tools: cv.tools }} />
      <Experience data={cv.experience} />
      <Projects data={cv.projects} />
      <Education data={cv.education} />
      <Certifications data={cv.certifications} />
      <Contact data={cv.contact} />
    </main>

    <Footer
      {lang}
      {cv}
    />
  </body>
</html>
