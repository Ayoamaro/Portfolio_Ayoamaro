---
type Experience = {
  company: string;
  position: string;
  startDate: string;
  endDate: string;
  avatar: string;
  summary: string;
  image?: string;
};

const { item, index, isLast } = Astro.props as {
  item: Experience;
  index: number;
  isLast: boolean;
};

const dateLabel = `${item.startDate} - ${item.endDate}`;
---

<li class="relative">
  <div class="flex gap-6 sm:gap-10">
    <!-- Timeline rail -->
    <div class="relative flex w-14 shrink-0 justify-center">
      <div
        class:list={[
          'absolute left-1/2 top-0 -translate-x-1/2 w-1 rounded-full',
          'bg-(--border)',
          isLast ? 'h-12' : 'h-full',
        ]}
        aria-hidden="true"
      />

      <div class="relative mt-2">
        <div
          class="h-5 w-5 rounded-full"
          style="
            background: var(--bg);
            box-shadow: 0 0 0 4px var(--accent);
          "
        />
      </div>
    </div>

    <!-- Content -->
    <div class="min-w-0 flex-1 pb-10 sm:pb-12">
      <p class="text-sm font-semibold text-(--muted)">{dateLabel}</p>

      <div class="mt-3 flex items-start gap-3">
        <img
          src={item.avatar}
          alt={`Avatar de ${item.company}`}
          width="40"
          height="40"
          loading="lazy"
          class="h-10 w-10 shrink-0 rounded-md object-cover"
          style="box-shadow: 0 0 0 1px var(--border);"
        />

        <div class="min-w-0">
          <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight text-(--text)">
            {item.position}
            <span class="mx-2 text-(--muted)">–</span>
            <span class="font-semibold text-(--accent)">
              {item.company}
            </span>
          </h3>

          <p class="mt-2 text-pretty text-(--muted) leading-relaxed">
            {item.summary}
          </p>

          {item.image ? (
            <>
              <button
                id={`exp-open-${index}`}
                type="button"
                class="mt-5 block text-left rounded-xl focus-visible:outline-none"
                aria-label="Abrir imagen en grande"
              >
                <img
                  src={item.image}
                  alt={`Vista previa de ${item.company}`}
                  loading="lazy"
                  class="w-full max-w-[200px] max-h-[200px] rounded-xl object-cover cursor-zoom-in transition-transform duration-300 hover:scale-[1.01]"
                  style="box-shadow: 0 0 0 1px var(--border);"
                />
              </button>

              <dialog
                id={`exp-dialog-${index}`}
                class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 p-0 rounded-2xl backdrop:bg-black/60"
                style="background: var(--surface); color: var(--text); border: 1px solid var(--border);"
              >
                <div class="relative p-3 sm:p-4">
                  <form method="dialog">
                    <button
                      class="absolute right-2 top-2 inline-flex h-9 w-9 items-center justify-center rounded-xl transition"
                      style="background: var(--bg); color: var(--text); box-shadow: 0 0 0 1px var(--border);"
                      aria-label="Cerrar"
                      title="Cerrar"
                    >
                      ✕
                    </button>
                  </form>

                  <img
                    src={item.image}
                    alt={`Imagen ampliada de ${item.company}`}
                    class="block max-h-[80vh] w-auto max-w-[90vw] rounded-xl object-contain"
                    style="background: var(--bg);"
                  />
                </div>
              </dialog>

              <script define:vars={{ index }}>
                const openBtn = document.getElementById(`exp-open-${index}`);
                const dialog = document.getElementById(`exp-dialog-${index}`);

                openBtn?.addEventListener('click', () => dialog?.showModal());

                dialog?.addEventListener('click', (e) => {
                  if (e.target === dialog) dialog.close();
                });
              </script>
            </>
          ) : null}
        </div>
      </div>
    </div>
  </div>
</li>
