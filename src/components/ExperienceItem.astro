---
type Experience = {
  company: string;
  position: string;
  startDate: string;
  endDate: string;
  avatar: string;
  summary: string;
  image?: string;
};

const { item, index, isLast } = Astro.props as {
  item: Experience;
  index: number;
  isLast: boolean;
};

const dateLabel = `${item.startDate} - ${item.endDate}`;
---

<li class="relative">
  <div class="flex gap-6 sm:gap-10">
    <!-- Timeline rail -->
    <div class="relative flex w-14 shrink-0 justify-center">
      <div
        class:list={[
          "absolute left-1/2 top-0 -translate-x-1/2 w-1 rounded-full",
          "bg-slate-200 dark:bg-slate-700",
          isLast ? "h-12" : "h-full",
        ]}
        aria-hidden="true"
      />

      <div class="relative mt-2">
        <div class="h-5 w-5 rounded-full bg-white dark:bg-slate-900 ring-4 ring-orange-500" />
      </div>
    </div>

    <!-- Content -->
    <div class="min-w-0 flex-1 pb-10 sm:pb-12">
      <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">
        {dateLabel}
      </p>

      <div class="mt-3 flex items-start gap-3">
        <img
          src={item.avatar}
          alt={`Avatar de ${item.company}`}
          loading="lazy"
          class="h-10 w-10 rounded-md object-cover ring-1 ring-slate-200 dark:ring-slate-700"
        />

        <div class="min-w-0">
          <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-slate-50">
            {item.position}
            <span class="text-slate-400 dark:text-slate-500">–</span>
            {item.company}
          </h3>

          <p class="mt-2 text-pretty text-slate-600 dark:text-slate-300 leading-relaxed">
            {item.summary}
          </p>

          {item.image ? (
            <>
              <button
                id={`exp-open-${index}`}
                type="button"
                class="mt-5 block text-left"
                aria-label="Abrir imagen en grande"
              >
                <img
                  src={item.image}
                  alt={`Vista previa de ${item.company}`}
                  loading="lazy"
                  class="w-full max-w-[200px] max-h-[200px] rounded-xl object-cover ring-1 ring-slate-200 dark:ring-slate-800 cursor-zoom-in"
                />
              </button>

              <dialog
                id={`exp-dialog-${index}`}
                class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 p-0 rounded-2xl bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-50 backdrop:bg-black/60"
              >
                <div class="relative p-3 sm:p-4">
                  <form method="dialog">
                    <button
                      class="absolute right-2 top-2 inline-flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700"
                      aria-label="Cerrar"
                    >
                      ✕
                    </button>
                  </form>

                  <img
                    src={item.image}
                    alt={`Imagen ampliada de ${item.company}`}
                    class="block max-h-[80vh] w-auto max-w-[90vw] rounded-xl object-contain"
                  />
                </div>
              </dialog>

              <script define:vars={{ index }}>
                const openBtn = document.getElementById(`exp-open-${index}`);
                const dialog = document.getElementById(`exp-dialog-${index}`);

                openBtn?.addEventListener("click", () => dialog?.showModal());

                dialog?.addEventListener("click", (e) => {
                  if (e.target === dialog) dialog.close();
                });
              </script>
            </>
          ) : null}
        </div>
      </div>
    </div>
  </div>
</li>
