---
import CertificationsItem from './CertificationsItem.astro';

type CertificationsHeader = {
  title: string;
  description: string;
};

type Certification = {
  issuer: string;
  title: string;
  issueDate: string;
  summary: string;
  image: string;
  credentialUrl: string;
};

type CertificationsData = [CertificationsHeader, ...Certification[]];

const { data } = Astro.props as { data: CertificationsData };
const [header, ...items] = data;
---

<section
  id="certifications"
  class="mx-auto w-full max-w-6xl scroll-mt-28 px-4 py-20"
>
  <header class="text-center">
    <h2
      class="text-4xl font-extrabold tracking-tight text-(--text) sm:text-5xl"
    >
      {header.title}
    </h2>
    <p class="mx-auto mt-4 max-w-2xl text-pretty text-(--muted)">
      {header.description}
    </p>
  </header>

  <div class="relative mt-14">
    <!-- Prev / Next (desktop) -->
    <button
      type="button"
      class="absolute top-1/2 -left-3 z-10 hidden -translate-y-1/2 rounded-full border px-3 py-2 text-sm shadow-sm transition focus-visible:outline-none md:block"
      style="background: color-mix(in srgb, var(--bg) 88%, transparent); border-color: var(--border); color: var(--text);"
      data-cert-prev
      aria-label="Certificación anterior"
      title="Anterior"
    >
      ←
    </button>

    <button
      type="button"
      class="absolute top-1/2 -right-3 z-10 hidden -translate-y-1/2 rounded-full border px-3 py-2 text-sm shadow-sm transition focus-visible:outline-none md:block"
      style="background: color-mix(in srgb, var(--bg) 88%, transparent); border-color: var(--border); color: var(--text);"
      data-cert-next
      aria-label="Siguiente certificación"
      title="Siguiente"
    >
      →
    </button>

    <!-- Slider -->
    <div
      class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-6 [-ms-overflow-style:none] [scrollbar-width:none]"
      tabindex="0"
      role="region"
      aria-roledescription="carousel"
      aria-label="Certificaciones"
      data-cert-slider
    >
      <style>
        #certifications [data-cert-slider]::-webkit-scrollbar {
          display: none;
        }
      </style>

      {
        items.map((item, index) => (
          <div
            id={`cert-slide-${index}`}
            class="w-full shrink-0 snap-center md:w-[920px]"
            data-cert-slide
            data-index={index}
            role="group"
            aria-label={`${index + 1} de ${items.length}`}
          >
            <CertificationsItem item={item} />
          </div>
        ))
      }
    </div>

    <!-- Dots -->
    <div
      class="mt-4 flex justify-center gap-2"
      aria-label="Paginación de certificaciones"
      data-cert-dots
    >
      {
        items.map((_, index) => (
          <button
            type="button"
            class="h-2.5 w-10 rounded-full transition focus-visible:outline-none"
            style="background: color-mix(in srgb, var(--muted) 35%, transparent);"
            data-cert-dot
            data-index={index}
            aria-label={`Ir a la certificación ${index + 1}`}
            aria-controls={`cert-slide-${index}`}
            aria-current={index === 0 ? 'true' : undefined}
            title={`Certificación ${index + 1}`}
          />
        ))
      }
    </div>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('#certifications');
      if (!root) return;

      const slider = root.querySelector('[data-cert-slider]');
      const slides = Array.from(root.querySelectorAll('[data-cert-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-cert-dot]'));
      const btnPrev = root.querySelector('[data-cert-prev]');
      const btnNext = root.querySelector('[data-cert-next]');

      if (!slider || slides.length === 0) return;

      let activeIndex = 0;

      const setActive = (index) => {
        activeIndex = Math.max(0, Math.min(slides.length - 1, index));

        dots.forEach((dot, i) => {
          const isActive = i === activeIndex;

          dot.style.background = isActive
            ? 'var(--accent)'
            : 'color-mix(in srgb, var(--muted) 35%, transparent)';

          if (isActive) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      const goTo = (index) => {
        setActive(index);
        slides[activeIndex].scrollIntoView({
          behavior: 'smooth',
          inline: 'center',
          block: 'nearest',
        });
      };

      dots.forEach((dot) => {
        dot.addEventListener('click', () =>
          goTo(Number(dot.dataset.index || '0'))
        );
      });

      btnPrev?.addEventListener('click', () => goTo(activeIndex - 1));
      btnNext?.addEventListener('click', () => goTo(activeIndex + 1));

      slider.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') goTo(activeIndex - 1);
        if (e.key === 'ArrowRight') goTo(activeIndex + 1);
      });

      const io = new IntersectionObserver(
        (entries) => {
          const best = entries
            .filter((en) => en.isIntersecting)
            .sort(
              (a, b) => (b.intersectionRatio ?? 0) - (a.intersectionRatio ?? 0)
            )[0];

          if (!best) return;
          const idx = Number(best.target.getAttribute('data-index') || '0');
          setActive(idx);
        },
        { root: slider, threshold: [0.55, 0.65, 0.75] }
      );

      slides.forEach((s) => io.observe(s));
      setActive(0);
    })();
  </script>
</section>
