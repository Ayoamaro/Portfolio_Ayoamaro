---
import LinkedIn from './icons/LinkedIn.astro';
import InfoJobs from './icons/InfoJobs.astro';
import TecnoEmpleo from './icons/TecnoEmpleo.astro';

const SOCIALS = {
  LINKEDIN: {
    tag: 'LINKEDIN',
    url: 'https://www.linkedin.com/in/ayoamaro/',
    class: 'bg-[var(--surface)] text-[var(--text)] hover:shadow-md',
    icon: LinkedIn,
  },
  INFOJOBS: {
    tag: 'INFOJOBS',
    url: 'https://www.infojobs.net/candidate/cv/view/index.xhtml',
    class: 'bg-[var(--surface)] text-[var(--text)] hover:shadow-md',
    icon: InfoJobs,
  },
  TECNOEMPLEO: {
    tag: 'TECNOEMPLEO',
    url: 'https://www.tecnoempleo.com/ayoze-amaro-estevez.mpt',
    class: 'bg-[var(--surface)] text-[var(--text)] hover:shadow-md',
    icon: TecnoEmpleo,
  },
} as const;

type HeroData = {
  greeting: string;
  name: string;
  roleLines: string[];
  description: string;
  cta: { label: string; href: string };
  image: string;
};

const { data } = Astro.props as { data: HeroData };
const socials = [SOCIALS.LINKEDIN, SOCIALS.INFOJOBS, SOCIALS.TECNOEMPLEO];

if (!data) throw new Error('[Hero] Missing prop: data');
if (!Array.isArray(data.roleLines))
  throw new Error('[Hero] data.roleLines must be an array');
---

<section
  id="home"
  class="pt-6 md:pt-10"
>
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <!-- LEFT -->
      <div>
        <p class="text-sm font-semibold tracking-wide text-(--muted)">
          {data.greeting}
        </p>

        <h5 class="mt-2 text-2xl font-extrabold text-(--accent) sm:text-3xl">
          {data.name}
        </h5>

        <h2 class="mt-3 text-5xl leading-[0.95] font-black sm:text-6xl">
          {
            data.roleLines.map((line, index) => {
              const isLast = index === data.roleLines.length - 1;

              return (
                <span
                  class={`block ${
                    isLast ? 'ml-0 text-(--text) sm:ml-45' : 'text-(--muted)'
                  }`}
                >
                  {line}
                </span>
              );
            })
          }
        </h2>

        <p class="mt-6 max-w-xl text-(--muted)">
          {data.description}
        </p>

        <div class="mt-8">
          <button
            type="button"
            onclick={`location.href='${data.cta.href}'`}
            class="inline-flex items-center justify-center rounded-md bg-(--accent) px-6 py-3 text-sm font-semibold text-(--accent-contrast) transition-all duration-300 ease-out hover:-translate-y-0.5 focus-visible:outline-none"
          >
            {data.cta.label}
          </button>
        </div>
      </div>

      <!-- RIGHT -->
      <div class="flex flex-col items-center">
        <div class="relative">
          <img
            src={data.image}
            alt={`Foto de ${data.name}`}
            loading="eager"
            class="pointer-events-none drop-shadow-lg select-none sm:h-72 md:h-120"
          />
        </div>

        <div class="mt-6 flex items-center gap-3">
          {
            socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noreferrer"
                aria-label={s.tag}
                title={s.tag}
                class={`group inline-flex h-10 w-10 items-center justify-center rounded-md bg-(--surface) shadow-sm transition hover:scale-[1.03] focus-visible:outline-none`}
              >
                <s.icon class="h-5 w-5 transition-colors duration-300 group-hover:text-(--accent)" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
