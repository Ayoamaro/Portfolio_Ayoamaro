---
import ReactIcon from './icons/React.astro';
import TailwindIcon from './icons/Tailwind.astro';
import NodeIcon from './icons/Node.astro';
import JavaIcon from './icons/Java.astro';
import PhpIcon from './icons/PHP.astro';
import MySqlIcon from './icons/MySQL.astro';
import HtmlIcon from './icons/HTML.astro';
import CssIcon from './icons/CSS.astro';
import JavascriptIcon from './icons/Javascript.astro';
import VueIcon from './icons/Vue.astro';

const ICONS = {
  react: ReactIcon,
  tailwind: TailwindIcon,
  node: NodeIcon,
  java: JavaIcon,
  php: PhpIcon,
  mysql: MySqlIcon,
  html: HtmlIcon,
  css: CssIcon,
  javascript: JavascriptIcon,
  vue: VueIcon,
} as const;

type AboutData = {
  about: {
    title: string;
    description: string;
    image: string;
  };
  skills: Array<{
    name: string;
    level: number;
    icon: keyof typeof ICONS;
  }>;
  tools: Array<{
    icon: keyof typeof ICONS;
    level: number;
  }>;
};

const { data } = Astro.props as { data: AboutData };
const { about, skills, tools } = data;

const clamp = (n: number) => Math.max(0, Math.min(100, n));

const TOOL_LABELS: Record<keyof typeof ICONS, string> = {
  react: 'React',
  tailwind: 'Tailwind CSS',
  node: 'Node.js',
  java: 'Java',
  php: 'PHP',
  mysql: 'MySQL',
  html: 'HTML',
  css: 'CSS',
  javascript: 'JavaScript',
  vue: 'Vue',
};
---

<section
  id="about"
  class="scroll-mt-28 py-24"
>
  <div class="mx-auto max-w-5xl px-6">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <!-- Imagen -->
      <div class="flex justify-center md:justify-start">
        <img
          src={about.image}
          alt={about.title}
          loading="eager"
          class="object-cover drop-shadow-lg sm:h-72 sm:w-72 md:h-120 md:w-100"
        />
      </div>

      <!-- Contenido -->
      <div>
        <h2
          class="text-4xl font-extrabold tracking-tight text-(--text) sm:text-5xl"
        >
          {about.title}
        </h2>

        <p class="mx-auto mt-4 max-w-2xl text-pretty text-(--muted)">
          {about.description}
        </p>

        <!-- Skills -->
        <div class="mt-5 space-y-6">
          {
            skills.map((skill) => {
              if (!skill?.name) throw new Error('[About] Skill missing name');
              if (typeof skill.level !== 'number')
                throw new Error(`[About] Skill "${skill.name}" missing level`);
              if (!skill.icon)
                throw new Error(`[About] Skill "${skill.name}" missing icon`);

              const SkillIcon = ICONS[skill.icon];
              const value = clamp(skill.level);

              return (
                <div>
                  <div class="mb-2 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span
                        class="inline-flex h-5 w-5 text-(--text)"
                        aria-hidden="true"
                      >
                        <SkillIcon class="h-5 w-5" />
                      </span>
                      <span class="font-medium text-(--text)">
                        {skill.name}
                      </span>
                    </div>

                    <span class="text-sm text-(--muted)">{value}%</span>
                  </div>

                  <div
                    class="h-2 w-full rounded-full"
                    style="background: var(--border);"
                    aria-hidden="true"
                  >
                    <div
                      class="h-2 rounded-full"
                      style={`width: ${value}%; background: var(--accent);`}
                    />
                  </div>
                </div>
              );
            })
          }
        </div>

        <!-- Tools -->
        <div class="mt-10 flex flex-wrap gap-4">
          {
            tools.map((tool) => {
              if (!tool?.icon) throw new Error('[About] Tool missing icon');
              if (typeof tool.level !== 'number')
                throw new Error(`[About] Tool "${tool.icon}" missing level`);

              const ToolIcon = ICONS[tool.icon];
              const value = clamp(tool.level);
              const label = TOOL_LABELS[tool.icon] ?? tool.icon;

              return (
                <div
                  class="relative h-14 w-14"
                  role="progressbar"
                  aria-label={`Nivel de ${label}`}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow={value}
                  title={`${label}`}
                >
                  <svg
                    viewBox="0 0 36 36"
                    class="h-14 w-14 -rotate-90"
                    aria-hidden="true"
                  >
                    <circle
                      cx="18"
                      cy="18"
                      r="15.915"
                      fill="none"
                      stroke="var(--border)"
                      stroke-width="3.5"
                    />
                    <circle
                      cx="18"
                      cy="18"
                      r="15.915"
                      fill="none"
                      stroke="var(--accent)"
                      stroke-width="3.5"
                      stroke-linecap="round"
                      stroke-dasharray={`${value} 100`}
                    />
                  </svg>

                  <div
                    class="absolute inset-0 grid place-items-center"
                    aria-hidden="true"
                  >
                    <span class="inline-flex h-6 w-6 text-(--text)">
                      <ToolIcon class="h-6 w-6" />
                    </span>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>
