---
import data from '../data/CV_es.json';
import ReactIcon from './icons/React.astro';
import TailwindIcon from './icons/Tailwind.astro';
import NodeIcon from './icons/Node.astro';
import JavaIcon from './icons/Java.astro';
import PhpIcon from './icons/PHP.astro';
import MySqlIcon from './icons/MySQL.astro';
import HtmlIcon from './icons/HTML.astro';
import CssIcon from './icons/CSS.astro';
import JavascriptIcon from './icons/Javascript.astro';
import VueIcon from './icons/Vue.astro';

const { about, skills, tools } = data;

const ICONS = {
  react: ReactIcon,
  tailwind: TailwindIcon,
  node: NodeIcon,
  java: JavaIcon,
  php: PhpIcon,
  mysql: MySqlIcon,

  html: HtmlIcon,
  css: CssIcon,
  javascript: JavascriptIcon,
  vue: VueIcon,
} as const;
---

<section
  id="about"
  class="py-24"
>
  <div class="container mx-auto px-6">
    <div class="grid items-center gap-16 md:grid-cols-2">
      <div class="flex justify-center">
        <img
          src={about.image}
          alt="Foto de perfil"
          class="h-72 w-72 rounded-full object-cover shadow-lg"
        />
      </div>
      <div>
        <h2 class="mb-4 text-4xl font-black sm:text-6xl">
          {about.title}
        </h2>
        <p class="mb-8 max-w-xl text-gray-600 dark:text-gray-300">
          {about.description}
        </p>
        <div class="space-y-6">
          {
            skills.map((skill) => {
              const SkillIcon = ICONS[skill.icon as keyof typeof ICONS];

              return (
                <div>
                  <div class="mb-1 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      {SkillIcon && (
                        <span class="inline-flex h-5 w-5">
                          <SkillIcon />
                        </span>
                      )}
                      <span class="font-medium">{skill.name}</span>
                    </div>

                    <span class="text-sm text-gray-500">{skill.level}%</span>
                  </div>

                  <div class="h-2 w-full rounded-full bg-gray-200 dark:bg-gray-700">
                    <div
                      class="h-2 rounded-full bg-orange-500 transition-all"
                      style={`width: ${skill.level}%`}
                    />
                  </div>
                </div>
              );
            })
          }
        </div>
        <div class="mt-10 flex flex-wrap gap-4">
          {
            tools.map((tool) => {
              const ToolIcon = ICONS[tool.icon as keyof typeof ICONS];

              return (
                <div class="flex h-14 w-14 items-center justify-center rounded-full border-4 border-orange-500">
                  {ToolIcon ? (
                    <span class="inline-flex h-6 w-6">
                      <ToolIcon />
                    </span>
                  ) : (
                    <span class="text-xs text-gray-500">{tool.icon}</span>
                  )}
                </div>
              );
            })
          }
        </div>
      </div>
    </div>
  </div>
</section>
