---
import EducationItem from './EducationItem.astro';

type EducationHeader = {
  title: string;
  description: string;
};

type EducationItemType = {
  institution: string;
  degree: string;
  startDate: string;
  endDate: string;
  grade?: string;
  summary: string;
  avatar: string;
};

type EducationData = Array<EducationHeader | EducationItemType>;

const { data } = Astro.props as { data: EducationData };
const header = data[0] as EducationHeader;
const items = data.slice(1) as EducationItemType[];
---

<section
  id="education"
  class="scroll-mt-28 py-24"
>
  <div class="container mx-auto w-full max-w-5xl px-4">
    <header class="text-center">
      <h2 class="text-5xl font-extrabold tracking-tight text-(--text)">
        {header.title}
      </h2>
      <p class="mx-auto mt-3 max-w-3xl text-(--muted)">
        {header.description}
      </p>
    </header>

    <ul class="mt-14">
      {
        items.map((item, index) => (
          <EducationItem
            item={item}
            isLast={index === items.length - 1}
          />
        ))
      }
    </ul>
  </div>
</section>
