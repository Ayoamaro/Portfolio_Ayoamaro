---
type Certification = {
  issuer: string;
  title: string;
  issueDate: string;
  summary: string;
  image: string;
  credentialUrl: string;
};

const { item } = Astro.props as { item: Certification };
const dateLabel = `${item.issueDate}`;
---

<article
  class="rounded-2xl p-6 shadow-sm md:p-8"
  style="background: var(--surface); border: 1px solid var(--border);"
>
  <div
    class="flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-10"
  >
    <!-- Logo -->
    <div class="flex w-full justify-center md:w-auto md:justify-start">
      <img
        src={item.image}
        alt={`Certificación ${item.issuer}`}
        class="h-28 w-28 object-contain md:h-32 md:w-32"
        loading="lazy"
      />
    </div>

    <!-- Texto -->
    <div class="w-full">
      <p class="relative text-sm leading-relaxed text-(--muted)">
        <span class="text-(--accent)">“</span>
        {item.summary}
        <span class="text-(--accent)">”</span>
      </p>

      <div class="mt-4">
        <h3 class="text-lg font-semibold text-(--text)">
          {item.issuer}
        </h3>

        <p class="text-sm text-(--muted)">
          {item.title}
        </p>

        <p class="mt-1 text-xs text-(--accent)">
          Fecha de emisión: {dateLabel}
        </p>

        <a
          href={item.credentialUrl}
          target="_blank"
          rel="noreferrer"
          class="mt-4 inline-flex items-center gap-2 rounded-xl border border-(--border) bg-(--surface) px-4 py-2 text-sm font-semibold text-(--text) shadow-sm transition-all duration-300 ease-out hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))] focus-visible:outline-none"
        >
          Ver credencial <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</article>
