---
import ExperienceItem from './ExperienceItem.astro';

type ExperienceHeader = {
  title: string;
  description: string;
};

type Experience = {
  company: string;
  position: string;
  startDate: string;
  endDate: string;
  avatar: string;
  summary: string;
  image?: string;
};

type ExperienceData = Array<ExperienceHeader | Experience>;

const { data } = Astro.props as { data: ExperienceData };
if (!data) throw new Error('[Experience] Missing prop: data');

const header = data[0] as ExperienceHeader;
const experiences = data.slice(1) as Experience[];
---

<section
  id="experience"
  class="scroll-mt-28 py-20"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <header class="text-center">
      <h2
        class="text-4xl font-extrabold tracking-tight text-(--text) sm:text-5xl"
      >
        {header.title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-pretty text-(--muted)">
        {header.description}
      </p>
    </header>

    <div class="mt-12 sm:mt-16">
      <ol class="relative">
        {
          experiences.map((item, index) => (
            <ExperienceItem
              item={item}
              index={index}
              isLast={index === experiences.length - 1}
            />
          ))
        }
      </ol>
    </div>
  </div>
</section>
