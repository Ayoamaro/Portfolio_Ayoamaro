---
import ExperienceItem from './ExperienceItem.astro';
import CV from '../data/CV_es.json';

const header = CV.experience[0];
const experiences = CV.experience.slice(1);
---

<section
  id="experience"
  class="py-20"
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <header class="text-center">
      <h2
        class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-50"
      >
        {header.title}
      </h2>
      <p
        class="mx-auto mt-4 max-w-2xl text-pretty text-slate-600 dark:text-slate-300"
      >
        {header.description}
      </p>
    </header>

    <div class="mt-12 sm:mt-16">
      <ol class="relative">
        {
          experiences.map((item, index) => (
            <ExperienceItem
              item={item}
              index={index}
              isLast={index === experiences.length - 1}
            />
          ))
        }
      </ol>
    </div>
  </div>
</section>
