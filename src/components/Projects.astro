---
import AstroIcon from './icons/AstroIcon.astro';
import TypeScriptIcon from './icons/TypeScript.astro';
import TailwindIcon from './icons/Tailwind.astro';
import VercelIcon from './icons/Vercel.astro';
import VueIcon from './icons/Vue.astro';
import ViteIcon from './icons/Vite.astro';
import PiniaIcon from './icons/Pinia.astro';
import NodeIcon from './icons/Node.astro';
import ExpressIcon from './icons/Express.astro';
import PostgresIcon from './icons/PostgreSQL.astro';
import SwaggerIcon from './icons/Swagger.astro';
import GitHubIcon from './icons/GitHub.astro';
import LinkIcon from './icons/Link.astro';
import NetlifyIcon from './icons/Netlify.astro';

type Project = {
  title: string;
  description: string;
  category: 'frontend' | 'backend';
  link: string;
  repo: string;
  tags: string[];
  image: string;
};

type ProjectsHeader = {
  title: string;
  description: string;
  labels: {
    seeMore: string;
    seeLess: string;
    preview: string;
    code: string;
  };
};

type ProjectsData = Array<ProjectsHeader | Project>;

const { data } = Astro.props as { data: ProjectsData };
const sectionHeader = data[0] as ProjectsHeader;
const projects = data.slice(1) as Project[];

const categories: string[] = [];
projects.forEach((p) => {
  if (!categories.includes(p.category)) categories.push(p.category);
});

const filterButtons: { key: string; label: string }[] = [
  { key: 'all', label: 'All' },
  ...categories.map((c) => ({
    key: c,
    label: c.charAt(0).toUpperCase() + c.slice(1),
  })),
];

const ACTIONS = {
  preview: {
    icon: LinkIcon,
    class:
      'bg-(--surface) border-(--border) text-(--text) hover:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))]',
  },
  github: {
    icon: GitHubIcon,
    class:
      'bg-(--surface) border-(--border) text-(--text) hover:border-[color-mix(in_srgb,var(--accent)_55%,var(--border))]',
  },
};

const TAGS: Record<string, { label: string; icon: any; class: string }> = {
  Astro: {
    label: 'Astro',
    icon: AstroIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  TypeScript: {
    label: 'TypeScript',
    icon: TypeScriptIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  Tailwind: {
    label: 'Tailwind',
    icon: TailwindIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  Vercel: {
    label: 'Vercel',
    icon: VercelIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  Vue: {
    label: 'Vue',
    icon: VueIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  Vite: {
    label: 'Vite',
    icon: ViteIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  Pinia: {
    label: 'Pinia',
    icon: PiniaIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  'Node.js': {
    label: 'Node.js',
    icon: NodeIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  Express: {
    label: 'Express',
    icon: ExpressIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  PostgreSQL: {
    label: 'PostgreSQL',
    icon: PostgresIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  Swagger: {
    label: 'Swagger',
    icon: SwaggerIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
  Netlify: {
    label: 'Netlify',
    icon: NetlifyIcon,
    class: 'bg-[--bg] border-[--border] text-[--text]',
  },
};
---

<section
  id="projects"
  class="scroll-mt-28 py-20"
>
  <div class="mx-auto w-full max-w-6xl px-4">
    <header class="text-center">
      <h2
        class="text-4xl font-extrabold tracking-tight text-(--text) sm:text-5xl"
      >
        {sectionHeader.title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-(--muted)">
        {sectionHeader.description}
      </p>
    </header>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      {
        filterButtons.map((btn) => (
          <button
            type="button"
            class="project-filter rounded-xl border px-4 py-2 text-sm font-medium shadow-sm transition hover:-translate-y-0.5 focus-visible:outline-none"
            data-filter={btn.key}
          >
            {btn.label}
          </button>
        ))
      }
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p) => (
          <article
            class="project-card group"
            data-category={p.category}
          >
            <div
              class="overflow-hidden rounded-2xl shadow-sm transition group-hover:shadow-md"
              style="background: var(--surface); border: 1px solid var(--border);"
            >
              <div
                class="relative aspect-4/3"
                style="background: var(--bg);"
              >
                <img
                  src={p.image}
                  alt={p.title}
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              </div>

              <div class="p-6">
                <p class="text-xs font-semibold tracking-wide text-(--accent) uppercase">
                  {p.category}
                </p>

                <h3 class="mt-2 text-lg leading-snug font-bold text-(--text)">
                  {p.title}
                </h3>

                <div class="mt-3">
                  <p class="project-desc line-clamp-3 text-sm leading-6 text-(--muted)">
                    {p.description}
                  </p>

                  <button
                    class="project-toggle mt-2 hidden text-sm font-semibold text-(--accent) transition-colors hover:text-(--accent-hover) focus-visible:outline-none"
                    data-see-more={sectionHeader.labels.seeMore}
                    data-see-less={sectionHeader.labels.seeLess}
                  >
                    {sectionHeader.labels.seeMore}
                  </button>
                </div>

                <div class="mt-4 flex flex-wrap gap-2">
                  {p.tags.map((t) => {
                    const tag = TAGS[t];
                    const Icon = tag.icon;

                    return (
                      <span
                        class:list={[
                          'inline-flex items-center gap-2 rounded-full border px-2.5 py-1 text-xs font-medium',
                          'text-(--text)',
                          tag.class,
                        ]}
                        style="background: color-mix(in srgb, var(--bg) 92%, transparent); border-color: var(--border);"
                      >
                        <Icon
                          class="h-4 w-4"
                          aria-hidden="true"
                        />
                        <span>{tag.label}</span>
                      </span>
                    );
                  })}
                </div>

                <div class="mt-5 flex flex-wrap gap-3">
                  <a
                    href={p.link}
                    target="_blank"
                    rel="noreferrer"
                    class:list={[
                      'inline-flex items-center gap-2 rounded-xl border px-4 py-2 text-sm font-semibold transition-all duration-300 ease-out',
                      'shadow-sm hover:-translate-y-0.5 focus-visible:outline-none',
                      ACTIONS.preview.class,
                    ]}
                  >
                    <ACTIONS.preview.icon class="size-5" />
                    {sectionHeader.labels.preview}
                  </a>

                  <a
                    href={p.repo}
                    target="_blank"
                    rel="noreferrer"
                    class:list={[
                      'inline-flex items-center gap-2 rounded-xl border px-4 py-2 text-sm font-semibold transition-all duration-300 ease-out',
                      'shadow-sm hover:-translate-y-0.5 focus-visible:outline-none',
                      ACTIONS.github.class,
                    ]}
                  >
                    <ACTIONS.github.icon class="size-5" />
                    {sectionHeader.labels.code}
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <script is:inline>
    const buttons = Array.from(document.querySelectorAll('.project-filter'));
    const cards = Array.from(document.querySelectorAll('.project-card'));

    function setActive(btn) {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
    }

    function applyFilter(key) {
      const filter = (key || 'all').toLowerCase();
      cards.forEach((card) => {
        const category = (card.dataset.category || '').toLowerCase();
        const show = filter === 'all' || category === filter;
        card.classList.toggle('hidden', !show);
      });
    }

    const defaultBtn =
      buttons.find((b) => b.dataset.filter === 'all') || buttons[0];
    setActive(defaultBtn);
    applyFilter(defaultBtn.dataset.filter);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActive(btn);
        applyFilter(btn.dataset.filter);
      });
    });

    const toggles = Array.from(document.querySelectorAll('.project-toggle'));

    function isTruncated(el) {
      return (
        el.scrollHeight > el.clientHeight || el.scrollWidth > el.clientWidth
      );
    }

    function setupProjectToggle(btn) {
      const wrapper = btn.closest('div');
      const p = wrapper.querySelector('.project-desc');

      const seeMore = btn.dataset.seeMore;
      const seeLess = btn.dataset.seeLess;

      p.classList.add('line-clamp-3');

      const truncated = isTruncated(p);
      btn.classList.toggle('hidden', !truncated);

      if (!truncated) return;

      btn.addEventListener('click', () => {
        const isClamped = p.classList.contains('line-clamp-3');

        if (isClamped) {
          p.classList.remove('line-clamp-3');
          btn.textContent = seeLess;
          btn.setAttribute('aria-expanded', 'true');
        } else {
          p.classList.add('line-clamp-3');
          btn.textContent = seeMore;
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    toggles.forEach(setupProjectToggle);
    window.addEventListener('resize', () => {
      toggles.forEach((btn) => {
        const wrapper = btn.closest('div');
        const p = wrapper.querySelector('.project-desc');
        const expanded = !p.classList.contains('line-clamp-3');
        if (expanded) return;

        btn.classList.toggle('hidden', !isTruncated(p));
      });
    });
  </script>
</section>
