---
import CV from '../data/CV_es.json';
import AstroIcon from './icons/AstroIcon.astro';
import TypeScriptIcon from './icons/TypeScript.astro';
import TailwindIcon from './icons/Tailwind.astro';
import VueIcon from './icons/Vue.astro';
import ViteIcon from './icons/Vite.astro';
import PiniaIcon from './icons/Pinia.astro';
import NodeIcon from './icons/Node.astro';
import ExpressIcon from './icons/Express.astro';
import PostgresIcon from './icons/PostgreSQL.astro';
import SwaggerIcon from './icons/Swagger.astro';
import GitHubIcon from './icons/GitHub.astro';
import LinkIcon from './icons/Link.astro';
import Link from './icons/Link.astro';

type Project = {
  title: string;
  description: string;
  category: 'frontend' | 'backend';
  link: string;
  repo: string;
  tags: string[];
  image: string;
};

type ProjectsHeader = {
  title: string;
  description: string;
};

const projectsRaw = CV.projects;
const sectionHeader = projectsRaw[0] as ProjectsHeader;
const projects = projectsRaw.slice(1) as Project[];
const categories: string[] = [];
projects.forEach((p) => {
  if (!categories.includes(p.category)) categories.push(p.category);
});

const filterButtons: { key: string; label: string }[] = [
  { key: 'all', label: 'All' },
];
categories.forEach((c) => {
  filterButtons.push({
    key: c,
    label: c.charAt(0).toUpperCase() + c.slice(1),
  });
});

const ACTIONS = {
  preview: {
    label: 'Preview',
    icon: LinkIcon,
    class:
      'bg-[#131a23] border-white/10 text-white hover:bg-[#1a2432] hover:border-white/20',
  },
  github: {
    label: 'Code',
    icon: GitHubIcon,
    class:
      'bg-[#131a23] border-white/10 text-white hover:bg-[#1a2432] hover:border-white/20',
  },
};

// Tags con color + icon
const TAGS: Record<string, { label: string; icon: any; class: string }> = {
  Astro: {
    label: 'Astro',
    icon: AstroIcon,
    class: 'bg-[#1b0a14] border-[#ff5d01]/30 text-[#ff5d01]',
  },
  TypeScript: {
    label: 'TypeScript',
    icon: TypeScriptIcon,
    class: 'bg-[#0b1e3a] border-[#3178c6]/30 text-[#3178c6]',
  },
  Tailwind: {
    label: 'Tailwind',
    icon: TailwindIcon,
    class: 'bg-[#06212a] border-[#38bdf8]/30 text-[#38bdf8]',
  },
  Vue: {
    label: 'Vue',
    icon: VueIcon,
    class: 'bg-[#071a12] border-[#42b883]/30 text-[#42b883]',
  },
  Vite: {
    label: 'Vite',
    icon: ViteIcon,
    class: 'bg-[#15112a] border-[#a855f7]/30 text-[#a855f7]',
  },
  Pinia: {
    label: 'Pinia',
    icon: PiniaIcon,
    class: 'bg-[#1a1406] border-[#f7d336]/30 text-[#f7d336]',
  },
  'Node.js': {
    label: 'Node.js',
    icon: NodeIcon,
    class: 'bg-[#0b160b] border-[#3c873a]/30 text-[#3c873a]',
  },
  Express: {
    label: 'Express',
    icon: ExpressIcon,
    class: 'bg-neutral-950 border-neutral-700 text-neutral-200',
  },
  PostgreSQL: {
    label: 'PostgreSQL',
    icon: PostgresIcon,
    class: 'bg-[#071a2b] border-[#336791]/30 text-[#336791]',
  },
  Swagger: {
    label: 'Swagger',
    icon: SwaggerIcon,
    class: 'bg-[#0f1406] border-[#85ea2d]/30 text-[#85ea2d]',
  },
};
---

<section
  id="projects"
  class="py-20"
>
  <div class="mx-auto w-full max-w-6xl px-4">
    <header class="text-center">
      <h2 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
        {sectionHeader.title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-neutral-300">
        {sectionHeader.description}
      </p>
    </header>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      {
        filterButtons.map((btn) => (
          <button
            type="button"
            class="project-filter rounded-xl border border-neutral-700 bg-neutral-900 px-4 py-2 text-sm font-medium text-neutral-100 transition hover:border-neutral-500"
            data-filter={btn.key}
          >
            {btn.label}
          </button>
        ))
      }
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p) => (
          <article
            class="project-card group"
            data-category={p.category}
          >
            <div class="overflow-hidden rounded-2xl bg-neutral-950 shadow-sm ring-1 ring-neutral-800 transition group-hover:shadow-md">
              <div class="relative aspect-4/3 bg-neutral-950">
                <img
                  src={p.image}
                  alt={p.title}
                  loading="lazy"
                  class="h-full w-full object-contain p-6"
                />
              </div>

              <div class="p-6">
                <p class="text-xs font-semibold tracking-wide text-orange-500 uppercase">
                  {p.category}
                </p>

                <h3 class="mt-2 text-lg leading-snug font-bold text-white">
                  {p.title}
                </h3>

                <div class="mt-3">
                  <p class="project-desc line-clamp-3 text-sm leading-6 text-neutral-300">
                    {p.description}
                  </p>

                  <button
                    type="button"
                    class="project-toggle mt-2 text-sm font-semibold text-orange-500 hover:underline"
                  >
                    Ver más...
                  </button>
                </div>

                <div class="mt-4 flex flex-wrap gap-2">
                  {p.tags.map((t) => {
                    const data = TAGS[t];
                    const Icon = data.icon;
                    return (
                      <span
                        class:list={[
                          'inline-flex items-center gap-2 rounded-full border px-2.5 py-1 text-xs font-medium',
                          data.class,
                        ]}
                      >
                        <Icon class="h-4 w-4" />
                        <span>{data.label}</span>
                      </span>
                    );
                  })}
                </div>

                <div class="mt-5 flex flex-wrap gap-3">
                  <a
                    href={p.link}
                    target="_blank"
                    rel="noreferrer"
                    class:list={[
                      'inline-flex items-center gap-2 rounded-xl border px-4 py-2 text-sm font-semibold transition',
                      'shadow-sm',
                      ACTIONS.preview.class,
                    ]}
                  >
                    <ACTIONS.preview.icon class="size-5" />
                    {ACTIONS.preview.label}
                    <span aria-hidden="true">↗</span>
                  </a>

                  <a
                    href={p.repo}
                    target="_blank"
                    rel="noreferrer"
                    class:list={[
                      'inline-flex items-center gap-2 rounded-xl border px-4 py-2 text-sm font-semibold transition',
                      'shadow-sm',
                      ACTIONS.github.class,
                    ]}
                  >
                    <ACTIONS.github.icon class="size-5" />
                    {ACTIONS.github.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <script is:inline>
    const buttons = Array.from(document.querySelectorAll('.project-filter'));
    const cards = Array.from(document.querySelectorAll('.project-card'));

    function setActive(btn) {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
    }

    function applyFilter(key) {
      const filter = (key || 'all').toLowerCase();
      cards.forEach((card) => {
        const category = (card.dataset.category || '').toLowerCase();
        const show = filter === 'all' || category === filter;
        card.classList.toggle('hidden', !show);
      });
    }

    const defaultBtn =
      buttons.find((b) => b.dataset.filter === 'all') || buttons[0];
    setActive(defaultBtn);
    applyFilter(defaultBtn.dataset.filter);

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        setActive(btn);
        applyFilter(btn.dataset.filter);
      });
    });

    // Ver más
    const toggles = Array.from(document.querySelectorAll('.project-toggle'));

    toggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        const wrapper = btn.closest('div');
        const p = wrapper.querySelector('.project-desc');

        const isClamped = p.classList.contains('line-clamp-3');
        if (isClamped) {
          p.classList.remove('line-clamp-3');
          btn.textContent = 'Ver menos';
        } else {
          p.classList.add('line-clamp-3');
          btn.textContent = 'Ver más...';
        }
      });
    });
  </script>
</section>
