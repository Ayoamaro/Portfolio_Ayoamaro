---
type Education = {
  institution: string;
  degree: string;
  startDate: string;
  endDate: string;
  grade?: string;
  summary: string;
  avatar?: string;
};

const { item, isLast } = Astro.props as {
  item: Education;
  isLast: boolean;
};

const dateLabel = `${item.startDate} - ${item.endDate}`;
---

<li class="relative">
  <div class="flex gap-6 sm:gap-10">
    <!-- Timeline rail -->
    <div class="relative flex w-14 shrink-0 justify-center">
      <div
        class:list={[
          'absolute top-0 left-1/2 w-1 -translate-x-1/2 rounded-full',
          'bg-(--border)',
          isLast ? 'h-12' : 'h-full',
        ]}
        aria-hidden="true"
      >
      </div>

      <div class="relative mt-2">
        <span class="sr-only">Punto de educación</span>
        <div
          class="h-5 w-5 rounded-full"
          style="
            background: var(--bg);
            box-shadow: 0 0 0 4px var(--accent);
          "
        >
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="min-w-0 flex-1 pb-10 sm:pb-12">
      <p class="text-sm font-semibold text-(--muted)">
        {dateLabel}
      </p>

      <div class="mt-3 flex items-start gap-3">
        {
          item.avatar ? (
            <img
              src={item.avatar}
              alt={`Avatar de ${item.institution}`}
              width="40"
              height="40"
              loading="lazy"
              class="h-10 w-10 shrink-0 rounded-md object-cover"
              style="box-shadow: 0 0 0 1px var(--border);"
            />
          ) : (
            <div
              class="grid h-10 w-10 place-items-center rounded-md"
              style="background: var(--surface); box-shadow: 0 0 0 1px var(--border);"
              aria-hidden="true"
            >
              <span class="text-xs font-bold text-(--muted)">
                {item.institution?.slice(0, 2)?.toUpperCase()}
              </span>
            </div>
          )
        }

        <div class="min-w-0">
          <h3
            class="text-xl font-extrabold tracking-tight text-(--text) sm:text-2xl"
          >
            {item.degree}
            <span class="mx-2 text-(--muted)">–</span>
            <span class="font-semibold text-(--accent)">
              {item.institution}
            </span>
          </h3>

          {
            item.grade && (
              <p class="mt-2 text-sm font-semibold text-(--muted)">
                <span class="text-(--muted)">{item.grade}</span>
              </p>
            )
          }

          <p class="mt-2 leading-relaxed text-pretty text-(--muted)">
            {item.summary}
          </p>
        </div>
      </div>
    </div>
  </div>
</li>
